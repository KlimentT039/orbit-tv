<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Window theme only: everything visible is drawn by Compose with OrbitTheme. -->
  <style name="Theme.Orbit" parent="android:Theme.Material.NoActionBar">
    <item name="android:windowBackground">@color/orbit_space_black</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
  </style>

  <style name="Theme.Orbit.Starting" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/orbit_space_black</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    <item name="postSplashScreenTheme">@style/Theme.Orbit</item>
  </style>
</resources>
